# Copy this file to .env and fill in real values. Never commit .env.

# LIVE integration — required for /api/recognize (photo exercise recognition)
# and /api/generate-plan (AI workout/meal plans). Sign up at https://console.anthropic.com
ANTHROPIC_API_KEY=

# STUB until set — required for /api/nutrition/search (food-to-calorie lookup).
# Free key at https://fdc.nal.usda.gov/api-key-signup
# Without this, the client falls back to manual calorie entry.
USDA_API_KEY=

# Origin of the Vite dev server / deployed frontend, for CORS.
CLIENT_ORIGIN=http://localhost:5173

PORT=8787
